/* 启动/异常引导页（仅当 web-view 未配置或出错时显示） */
.boot {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #141413;
  padding: 48rpx;
  box-sizing: border-box;
}

.boot-card {
  width: 100%;
  max-width: 560rpx;
  text-align: center;
  color: #e8e6e1;
}

.logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f5b301, #ff7a18);
  font-weight: 800;
  font-size: 48rpx;
  color: #141413;
  letter-spacing: 1rpx;
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.status {
  font-size: 28rpx;
  line-height: 1.6;
  color: #b9b6ae;
}

.hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #8a877f;
}
