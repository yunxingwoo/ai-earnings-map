<!-- 正常情况：全屏 web-view 加载已部署的站点 -->
<web-view
  wx:if="{{url}}"
  src="{{url}}"
  bindload="onWebviewLoad"
  binderror="onWebviewError"
></web-view>

<!-- 未配置地址 / 加载失败时的原生引导页 -->
<view wx:else class="boot">
  <view class="boot-card">
    <view class="logo"><text class="ai">AI</text></view>
    <view class="title">AI 算力财报全景</view>
    <view class="status">{{status}}</view>
    <view wx:if="{{failed}}" class="hint">部署与配置指引见 miniprogram/README.md</view>
  </view>
</view>
